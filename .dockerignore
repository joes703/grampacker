# An allowlist. Everything is excluded from the build context unless it is
# named below, so a new file (a secret, a database, a local cache) can never
# reach the image by accident. The image itself copies only build output
# (Dockerfile); this keeps the build stages clean too.
#
# Never allowed: .git, .env*, .data, dist, node_modules, docs, scripts, and
# every SQLite file.
*

!package.json
!package-lock.json
# ignore-scripts and save-exact; no credentials.
!.npmrc
!index.html
!public/
!src/
!shared/
!server/
!migrations/
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!vite.client.config.ts
!vite.server.config.ts

# Excluded again inside the allowed directories: tests and their helpers
# and fixtures, which no production file imports, and anything secret or
# local that could appear there.
**/*.test.ts
**/*.test.tsx
**/test/
**/.env*
**/*.db
**/*.db-*
**/*.sqlite*
**/.DS_Store
