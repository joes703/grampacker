{
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["server", "shared"],
  // The workerd test tier's setup, kept in place (with vitest.workers.config.ts)
  // until the Cloudflare tooling is removed. It needs the Workers types, which
  // cannot share a project with the Node types the server now uses.
  "exclude": ["server/test/apply-migrations.ts", "server/test/env.d.ts"]
}
