{
  "name": "grampacker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include vite.client.config.ts server/dev.ts",
    "build:client": "vite build --config vite.client.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "start:node": "node dist/server/node.js",
    "db:migrate": "tsx server/node.ts migrate",
    "build": "npm run typecheck && npm run lint && npm run build:client && npm run build:server",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:migrations": "node scripts/check-migration-safety.mjs",
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "check:yaml": "pipx run yamllint==1.37.1 .github/ .yamllint.yml"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.10",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hono/node-server": "2.1.5",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.104.3",
    "better-auth": "1.7.10",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
