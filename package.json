{
  "name": "grampacker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run lint && vite build",
    "typecheck": "wrangler types && tsc -b",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:api": "vitest run --config vitest.workers.config.ts",
    "test:migrations": "node scripts/check-migration-safety.mjs",
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "check:yaml": "yamllint .github/ .yamllint.yml",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.26",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.101.4",
    "better-auth": "1.6.26",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "hono": "4.13.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "8.3.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
