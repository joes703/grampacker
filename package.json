{
  "name": "grampacker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:node": "tsx watch --clear-screen=false --include vite.node.config.ts server/dev.ts",
    "build:client": "vite build --config vite.node.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "start:node": "node dist/server/node.js",
    "db:migrate": "tsx server/node.ts migrate",
    "build": "npm run typecheck && npm run lint && vite build && npm run build:server",
    "typecheck": "wrangler types && tsc -b",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:migrations": "node scripts/check-migration-safety.mjs",
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "check:yaml": "yamllint .github/ .yamllint.yml",
    "preview": "vite preview"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hono/node-server": "2.1.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.103.3",
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "hono": "4.13.11",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
