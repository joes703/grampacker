{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Only for the one .mjs listed below, which opens with `// @ts-check` so
    // it is checked under these strict settings; its test imports it and
    // would otherwise fail on the missing declaration (TS7016).
    "allowJs": true
  },
  // Every root-level config file must be listed, or `npm run build` goes green
  // while the config TypeScript rots. vitest.setup.ts is NOT here: it pulls in
  // jest-dom matchers and needs the DOM lib, so it belongs to the app project.
  //
  // `scripts/**/*.test.ts` is here and NOT in the app or worker project because
  // those tests use node:fs to read the repo's own files. `shared/` compiles
  // for both the browser and workerd and must stay free of node APIs, so a test
  // that needs one cannot live there.
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.workers.config.ts",
    "drizzle.config.ts",
    "scripts/check-migration-immutability.mjs",
    "scripts/**/*.test.ts"
  ]
}
