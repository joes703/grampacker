{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    // For the .mjs scripts listed below. Each opens with `// @ts-check`, so it
    // is checked under these strict settings, and a test can import it
    // without failing on a missing declaration (TS7016).
    "allowJs": true
  },
  // Every root-level config file must be listed, or `npm run build` goes green
  // while the config TypeScript rots. vitest.setup.ts is NOT here: it pulls in
  // jest-dom matchers and needs the DOM lib, so it belongs to the app project.
  //
  // `scripts/**/*.test.ts` is here and NOT in the app project because
  // those tests use node:fs to read the repo's own files. `shared/` compiles
  // for both the browser and server and must stay free of node APIs, so a test
  // that needs one cannot live there.
  "include": [
    "vite.client.config.ts",
    "vite.server.config.ts",
    "vitest.config.ts",
    "vitest.api.config.ts",
    "drizzle.config.ts",
    "scripts/check-action-pins.mjs",
    "scripts/check-migration-immutability.mjs",
    "scripts/check-migration-safety.mjs",
    "scripts/migration-rules.mjs",
    "scripts/schema-sql.ts",
    "scripts/**/*.test.ts",
    "server/**/*.ts"
  ]
}
