{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // Every root-level config file must be listed, or `npm run build` goes green
  // while the config TypeScript rots. vitest.setup.ts is NOT here: it pulls in
  // jest-dom matchers and needs the DOM lib, so it belongs to the app project.
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.workers.config.ts",
    "drizzle.config.ts"
  ]
}
