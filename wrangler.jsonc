{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grampacker",
  "main": "./server/index.ts",
  "compatibility_date": "2026-07-07",
  // better-auth needs node:crypto and AsyncLocalStorage; with a 2024-09-23+
  // compatibility date this enables the full built-in Node.js compat layer.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Non-API requests are served from the built SPA; unknown paths fall
    // back to index.html so client-side routing works on deep links.
    "not_found_handling": "single-page-application",
    // EVERY request goes through the Worker so the security-header
    // middleware covers the SPA shell and static assets, not just /api/*
    // (server/middleware/security-headers.ts). Costs one Worker
    // invocation per asset request - fine at this traffic, and it ports
    // to the Node target where the server fronts static files anyway.
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  // Pre-cutover custom domain: deploying claims next.grampacker.app in the
  // zone automatically (it is in the same Cloudflare account). Needed so
  // passkeys can register against the real rpID (grampacker.app) before
  // cutover; the apex stays on the old Pages app until phase 7.
  "routes": [
    { "pattern": "next.grampacker.app", "custom_domain": true }
  ],
  "vars": {
    // Production values; .dev.vars overrides in local dev.
    // BETTER_AUTH_URL is the single canonical origin: better-auth origin
    // validation and the CSRF middleware both check against it, so the
    // workers.dev URL still serves the SPA but refuses writes. WebAuthn
    // requires the real domain anyway.
    "BETTER_AUTH_URL": "https://next.grampacker.app",
    "EMAIL_FROM": "grampacker <no-reply@grampacker.app>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grampacker",
      // Created 2026-07-07 via `wrangler d1 create grampacker` (region WNAM).
      // Local dev never contacts this database - Miniflare provisions a
      // local SQLite from the binding.
      "database_id": "a5e96c0f-3165-4fa5-a654-efa71a94589d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
